# Copy to a private file per TV, edit, then source inside a subshell and run:
# tvhome --tv living-room configure
# Only configure reads these variables. Other commands load the saved TV profile.
# Reset every supported field so sourcing a second TV cannot inherit the first's secrets.
unset TV_HOST TV_LAUNCHER TV_CLIENT_KEY TV_CLIENT_KEY_FILE
unset TV_SSH_KEY TV_SSH_PORT TV_SSH_USER TV_SSH_KNOWN_HOSTS
unset TV_DEVMODE_TOKEN TVHOME_STATE_DIR HC_WATCHER_URL HC_RENEWAL_URL
unset TV_WATCH_ENABLED TV_RENEW_ENABLED

# TV address used by setup, pairing, catalog updates and the watcher.
export TV_HOST=""

# Optional background features; 1 enables each job, 0 disables it.
export TV_WATCH_ENABLED="0"
export TV_RENEW_ENABLED="0"

# Optional Healthchecks.io monitoring. Use a separate check for each enabled job
# and TV, with a notification integration enabled in the Healthchecks dashboard.
export HC_WATCHER_URL=""
export HC_RENEWAL_URL=""

# Setup saves an SSH key and host identity in ~/.tvhome/tvs/NAME/.
# Override their paths only when provisioning credentials separately.
# export TV_SSH_KEY="/absolute/private/path/to/this-tv-key"
# export TV_SSH_KNOWN_HOSTS="/absolute/private/path/to/known_hosts"
# export TV_SSH_USER="prisoner"
# export TV_SSH_PORT="9922"
# Optional token override for renewal; catalog publishing still uses SSH:
# export TV_DEVMODE_TOKEN=""

# Pair with tvhome --tv NAME pair, OR supply a key/file from private provisioning:
# export TV_CLIENT_KEY=""
# export TV_CLIENT_KEY_FILE="/absolute/private/path/to/this-tv-pairing.json"

# Optional launcher app ID:
# export TV_LAUNCHER="com.anant.tvhome.native"

# Optional base for runtime state; tvs/NAME is always appended to keep TVs isolated.
# Default base: ~/.tvhome
# export TVHOME_STATE_DIR="/absolute/private/state-base"
